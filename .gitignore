node_modules/
.next/
.env.local
*.log

# Проекты в репозитории песочницы не хранятся: у каждого мини-аппа своя
# жизнь и свой git. Здесь лежат только шаблон, скрипты и инструкции.
projects/*
!projects/.gitkeep

# Кэш npm: однажды уехал в репозиторий на 186 МБ и сломал git pull всем,
# кто уже клонировал. Кэш — штука машины, а не проекта.
.npm-cache/
